{
  "manifest_version": 3,

  "name": "DevStyle",

  "version": "2.0.0",

  "description": "Visually edit CSS properties of webpage elements in real time.",

  "permissions": [
    "activeTab"
  ],
"icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
},


  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "start-inspector": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Start DevStyle element inspector"
    }
  },

"action": {
    "default_popup": "popup.html",
    "default_title": "DevStyle",
    "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
},

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}